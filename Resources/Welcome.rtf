\outl0\strokewidth0 \strokec2 Welcome to MenuMeters 3.0.1\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b0\fs28 \cf0 MenuMeters shows CPU, disk, memory, and network activity in the macOS menu bar. It supports Apple Silicon and Intel Macs running macOS 26 or later.\
\pard\pardeftab720\sa248\partightenfactor0

\f0\b\fs30 \cf0 No automatic updates\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b0\fs28 \cf0 This personal fork has no updater. MenuMeters never checks for or downloads updates. To upgrade, quit the app and replace the app bundle manually.\
\pard\pardeftab720\sa248\partightenfactor0

